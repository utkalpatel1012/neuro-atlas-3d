{
  "name": "neuro-atlas-3d",
  "version": "0.1.1",
  "description": "Interactive 3D Human Brain Atlas for Advanced Academic Neuropsychiatry",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx src/schema_validation.test.ts && tsx src/pipeline_regression.test.ts && tsx src/rendering_engine.test.ts",
    "test:schema": "tsx src/schema_validation.test.ts",
    "test:pipeline": "tsx src/pipeline_regression.test.ts",
    "test:engine": "tsx src/rendering_engine.test.ts",
    "asset:validate": "tsx scripts/validate_asset.ts",
    "audit:phase1": "tsx scripts/audit_phase1.ts",
    "pipeline:run": "tsx scripts/pipeline/run_pipeline.ts"
  },
  "keywords": [
    "neuroanatomy",
    "3d",
    "psychiatry",
    "atlas",
    "threejs"
