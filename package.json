  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15"
  }
